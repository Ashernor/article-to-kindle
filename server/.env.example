# Copy these into Netlify → Site settings → Environment variables.
# Use YOUR OWN mailbox so the sender can be added to Amazon's approved list.

# Example for Gmail (create an App Password, not your normal password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=you@gmail.com

# Optional shared secret. If set, the extension must send the same token.
# RELAY_TOKEN=some-long-random-string
